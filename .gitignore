# Local configuration and secrets. Only the .env.example template is tracked.
.env
.env.*
!.env.example

# Python
.venv/
__pycache__/
.pytest_cache/

# dbt
target/
dbt_packages/
logs/
*.duckdb

# Terraform: providers, and state, which names every resource it created.
# The lock file is tracked.
.terraform/
*.tfstate
*.tfstate.*

# Editor and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Files downloaded by hand, waiting to be loaded into bronze
landing/

# Temporary n8n export, before normalize_workflows.py; it holds the owner of
# the instance.
n8n-export/
