# Copy this file to .env and replace the placeholder values.
# .env is ignored by git; never commit real credentials.

# Where S3 clients running on this machine reach the object store.
# Containers in the Compose network use http://storage:8333 instead.
S3_ENDPOINT_URL=http://localhost:8333
S3_REGION=us-east-1

# Administrator key pair the local object store is seeded with on first
# start. No job uses it; it is for a person inspecting the store.
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me

# One key pair per role, each allowed only what its role needs:
# ingestion writes bronze; dbt reads bronze and writes the silver and gold
# buckets of its own environment; the dashboard only reads prod gold.
S3_INGESTION_ACCESS_KEY_ID=change-me
S3_INGESTION_SECRET_ACCESS_KEY=change-me
S3_TRANSFORM_PROD_ACCESS_KEY_ID=change-me
S3_TRANSFORM_PROD_SECRET_ACCESS_KEY=change-me
S3_TRANSFORM_DEV_ACCESS_KEY_ID=change-me
S3_TRANSFORM_DEV_SECRET_ACCESS_KEY=change-me
S3_DASHBOARD_ACCESS_KEY_ID=change-me
S3_DASHBOARD_SECRET_ACCESS_KEY=change-me

# One bucket per lakehouse layer. Bronze is shared by both environments;
# silver and gold have a prod and a dev bucket.
S3_BUCKET_BRONZE=quetzal-bronze
S3_BUCKET_SILVER=quetzal-silver
S3_BUCKET_GOLD=quetzal-gold
S3_BUCKET_SILVER_DEV=quetzal-silver-dev
S3_BUCKET_GOLD_DEV=quetzal-gold-dev

# Secret keys of the keyed hash that pseudonymizes natural persons in gold,
# one per environment. Changing one changes every supplier key of that
# environment. Generate them like the Airflow secrets below.
PSEUDONYMIZATION_KEY_PROD=change-me
PSEUDONYMIZATION_KEY_DEV=change-me

# Airflow (only needed for `docker compose --profile airflow up`).
# Generate the secrets, for example with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# The Fernet key must be 32 url-safe base64-encoded bytes:
#   python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=change-me
AIRFLOW_FERNET_KEY=change-me
AIRFLOW_JWT_SECRET=change-me
AIRFLOW_API_SECRET_KEY=change-me
# Absolute path of this repository on the host, with forward slashes.
# Airflow's tasks mount landing/ from here.
PROJECT_HOST_DIR=C:/path/to/quetzal-lakehouse

# n8n (`docker compose --profile notifications up`). Compose checks that it
# is set on every command, like the values above.
# Encrypts the credentials n8n stores. Generate it like the Airflow secrets
# above, and keep it: with a different key n8n cannot read what it stored.
N8N_ENCRYPTION_KEY=change-me
