# Copy this file to .env and replace the placeholder values.
# .env is ignored by git; never commit real credentials.

# Key pair the local object store is seeded with on first start.
# Every S3 client that talks to it must sign its requests with this pair.
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me

# One bucket per lakehouse layer. Only the bronze layer exists so far.
S3_BUCKET_BRONZE=quetzal-bronze
